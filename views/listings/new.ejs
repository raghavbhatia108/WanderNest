<% layout('/layouts/boilerplate') %>

<div class="form-page">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9 col-12">
      <div class="form-card">

        <!-- Header -->
        <div class="mb-4">
          <a href="/listings" class="text-muted text-decoration-none d-inline-flex align-items-center gap-1 mb-3"
            style="font-size:0.85rem;">
            <i class="fa-solid fa-arrow-left"></i> Back to listings
          </a>
          <h2>List your stay</h2>
          <p class="form-subtitle">Share your space with travellers around the world</p>
        </div>

        <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

          <p class="form-section-label">Basic info</p>

          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">Listing title</label>
            <input type="text" name="listing[title]" id="title" class="form-control"
              placeholder="e.g. Cozy hillside cottage with mountain views" required>
            <div class="valid-feedback">Looks great!</div>
            <div class="invalid-feedback">Please add a title.</div>
          </div>

          <!-- Description -->
          <div class="mb-4">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" rows="4"
              placeholder="Describe your space — what makes it unique?" required></textarea>
            <div class="invalid-feedback">Please add a description.</div>
          </div>

          <p class="form-section-label">Location</p>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="location" class="form-label">City / Area</label>
              <input type="text" name="listing[location]" id="location" class="form-control"
                placeholder="e.g. Jaipur, Rajasthan" required>
              <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <div class="col-md-6">
              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" id="country" class="form-control"
                placeholder="e.g. India" required>
              <div class="invalid-feedback">Please enter a country.</div>
            </div>
          </div>

          <p class="form-section-label">Pricing &amp; Photos</p>

          <!-- Price -->
          <div class="mb-3">
            <label for="price" class="form-label">Price per night (₹)</label>
            <div class="input-group">
              <span class="input-group-text" style="border:1.5px solid var(--border);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);background:var(--bg);">₹</span>
              <input type="number" name="listing[price]" id="price" class="form-control"
                placeholder="1200" min="0" required
                style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;">
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
          </div>

          <!-- Image upload -->
          <div class="mb-4">
            <label for="image" class="form-label">Listing photo</label>
            <input type="file" name="listing[image]" id="image" class="form-control" accept="image/*">
            <div class="form-text text-muted" style="font-size:0.78rem;">
              <i class="fa-solid fa-circle-info me-1"></i>
              Supported formats: JPG, PNG, JPEG. Max size: 5 MB.
            </div>
          </div>

          <!-- Submit -->
          <div class="d-flex gap-2 align-items-center">
            <button type="submit" class="btn-primary-action">
              <i class="fa-solid fa-plus"></i> Create Listing
            </button>
            <a href="/listings" class="btn btn-outline-secondary rounded-pill px-3"
              style="font-size:0.875rem;">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
