<% layout('/layouts/boilerplate') -%>

<!-- Filters bar -->
<div class="filters-bar mt-3">
  <button class="filter-btn active" data-filter="all">
    <i class="fa-solid fa-fire"></i>
    <span>Trending</span>
  </button>
  <button class="filter-btn" data-filter="rooms">
    <i class="fa-solid fa-bed"></i>
    <span>Rooms</span>
  </button>
  <button class="filter-btn" data-filter="cities">
    <i class="fa-solid fa-mountain-city"></i>
    <span>Cities</span>
  </button>
  <button class="filter-btn" data-filter="mountains">
    <i class="fa-solid fa-mountain"></i>
    <span>Mountains</span>
  </button>
  <button class="filter-btn" data-filter="castles">
    <i class="fa-brands fa-fort-awesome"></i>
    <span>Castles</span>
  </button>
  <button class="filter-btn" data-filter="arctic">
    <i class="fa-solid fa-snowflake"></i>
    <span>Arctic</span>
  </button>
  <button class="filter-btn" data-filter="pools">
    <i class="fa-solid fa-person-swimming"></i>
    <span>Pools</span>
  </button>
  <button class="filter-btn" data-filter="camping">
    <i class="fa-solid fa-campground"></i>
    <span>Camping</span>
  </button>
  <button class="filter-btn" data-filter="farms">
    <i class="fa-solid fa-cow"></i>
    <span>Farms</span>
  </button>
  <button class="filter-btn" data-filter="domes">
    <i class="fa-solid fa-landmark-dome"></i>
    <span>Domes</span>
  </button>
  <button class="filter-btn" data-filter="boats">
    <i class="fa-solid fa-ship"></i>
    <span>Boats</span>
  </button>

  <!-- Tax toggle -->
  <div class="tax-toggle-wrap ms-auto">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="taxToggle">
      <label class="form-check-label" for="taxToggle">Show total with taxes</label>
    </div>
  </div>
</div>

<!-- Results count -->
<p class="text-muted mb-3" style="font-size:0.85rem;">
  <b><%= allListing.length %></b> stays found
</p>

<!-- Listings grid -->
<div class="listings-grid">
  <% for (let listing of allListing) { %>
    <a class="listing-card-wrap" href="/listings/<%= listing._id %>">
      <div class="listing-card">
        <div class="listing-img-wrap">
          <img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy">
        </div>
        <div class="listing-info">
          <div class="listing-info-row">
            <h6><%= listing.title %></h6>
            <div class="listing-rating">
              <i class="fa-solid fa-star"></i> New
            </div>
          </div>
          <p class="listing-location">
            <i class="fa-solid fa-location-dot me-1" style="color:var(--primary);font-size:0.7rem;"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>
          <p class="listing-price">
            ₹<%= listing.price.toLocaleString("en-IN") %>
            <span class="per-night">/ night</span>
            <i class="tax-info"> &nbsp;· ₹<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> incl. GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<% if (allListing.length === 0) { %>
  <div class="text-center py-5">
    <i class="fa-solid fa-magnifying-glass" style="font-size:3rem;color:var(--border);"></i>
    <h4 class="mt-3 fw-bold">No stays found</h4>
    <p class="text-muted">Try adjusting your search or explore all listings.</p>
    <a href="/listings" class="btn" style="background:var(--primary);color:white;border-radius:var(--radius);padding:0.6rem 1.5rem;font-weight:600;">Browse all stays</a>
  </div>
<% } %>

<script>
  // Tax toggle
  const taxToggle = document.getElementById("taxToggle");
  taxToggle.addEventListener("change", () => {
    document.querySelectorAll(".tax-info").forEach(el => {
      el.style.display = taxToggle.checked ? "inline" : "none";
    });
  });

  // Filter buttons (visual only — wire to backend categories if needed)
  document.querySelectorAll(".filter-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
    });
  });
</script>
