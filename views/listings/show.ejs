<% layout('/layouts/boilerplate') %>
<script>
  const mapToken   = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(foundListing.geometry.coordinates) %>;
</script>

<div class="show-page">

  <!-- Header -->
  <div class="show-header">
    <h1><%= foundListing.title %></h1>
    <div class="show-meta">
      <span class="meta-item">
        <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
        <b>New</b>
      </span>
      <span class="meta-item">
        <i class="fa-solid fa-location-dot" style="color:var(--primary);"></i>
        <%= foundListing.location %>, <%= foundListing.country %>
      </span>
    </div>
  </div>

  <!-- Hero image -->
  <div class="show-img-wrap">
    <img src="<%= foundListing.image.url %>" class="show-img" alt="<%= foundListing.title %>">
  </div>

  <!-- Two-column layout -->
  <div class="show-content">

    <!-- Left: details -->
    <div class="show-details">

      <!-- Host info -->
      <div class="show-host">
        <div class="host-avatar">
          <%= foundListing.owner.username.charAt(0) %>
        </div>
        <div class="host-info">
          <h6>Hosted by <%= foundListing.owner.username %></h6>
          <p>Superhost · WanderNest verified</p>
        </div>
      </div>

      <!-- Detail pills -->
      <div class="detail-pills">
        <span class="detail-pill">
          <i class="fa-solid fa-location-dot"></i> <%= foundListing.location %>
        </span>
        <span class="detail-pill">
          <i class="fa-solid fa-globe"></i> <%= foundListing.country %>
        </span>
        <span class="detail-pill">
          <i class="fa-solid fa-tag"></i> ₹<%= foundListing.price.toLocaleString("en-IN") %> / night
        </span>
      </div>

      <!-- Description -->
      <p class="description-text"><%= foundListing.description %></p>
    </div>

    <!-- Right: price card -->
    <div>
      <div class="price-card">
        <div class="price-main">
          ₹<%= foundListing.price.toLocaleString("en-IN") %>
          <span>/ night</span>
        </div>
        <p class="price-gst">₹<%= Math.round(foundListing.price * 1.18).toLocaleString("en-IN") %> total incl. 18% GST</p>

        <button class="btn-book" disabled>Reserve (coming soon)</button>

        <!-- Owner-only actions -->
        <% if (currUser && foundListing.owner._id.equals(currUser._id)) { %>
          <div class="owner-actions">
            <a href="/listings/<%= foundListing._id %>/edit" class="btn-edit">
              <i class="fa-solid fa-pen-to-square"></i> Edit
            </a>
            <form action="/listings/<%= foundListing._id %>?_method=DELETE" method="post" style="flex:1;">
              <button class="btn-delete w-100">
                <i class="fa-solid fa-trash-can"></i> Delete
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

  </div><!-- /show-content -->

  <!-- Reviews -->
  <div class="reviews-section">
    <h3 class="section-heading">
      <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
      Reviews
      <span class="badge" style="background:var(--primary-light);color:var(--primary);font-size:0.75rem;border-radius:50px;padding:0.2rem 0.7rem;">
        <%= foundListing.reviews.length %>
      </span>
    </h3>

    <!-- Leave a review form -->
    <% if (currUser) { %>
      <div class="review-form-card">
        <h6 class="fw-bold mb-3">Share your experience</h6>
        <form class="needs-validation" action="/listings/<%= foundListing._id %>/reviews" method="POST" novalidate>
          <div class="mb-3">
            <label class="form-label">Your rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Your comment</label>
            <textarea name="review[comment]" id="comment" rows="3"
              class="form-control" placeholder="What did you love about this stay?" required></textarea>
            <div class="invalid-feedback">Please write a comment before submitting.</div>
          </div>
          <button class="btn-primary-action" type="submit">
            <i class="fa-solid fa-paper-plane"></i> Post Review
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="review-form-card text-center py-4">
        <i class="fa-solid fa-lock mb-2" style="font-size:1.5rem;color:var(--text-muted);"></i>
        <p class="mb-2 text-muted">Log in to leave a review</p>
        <a href="/login" class="btn-primary-action" style="text-decoration:none;">Log In</a>
      </div>
    <% } %>

    <!-- Reviews grid -->
    <% if (foundListing.reviews.length > 0) { %>
      <div class="review-grid">
        <% for (let review of foundListing.reviews) { %>
          <div class="review-card">
            <div class="review-author">
              <div class="review-avatar"><%= review.author.username.charAt(0) %></div>
              <span class="review-username">@<%= review.author.username %></span>
            </div>
            <p class="starability-result mb-2" data-rating="<%= review.rating %>">
              Rated: <%= review.rating %> stars
            </p>
            <p class="review-text"><%= review.comment %></p>
            <% if (currUser && review.author._id.equals(currUser._id)) { %>
              <form action="/listings/<%= foundListing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn-review-delete" type="submit">
                  <i class="fa-solid fa-trash-can me-1"></i>Delete
                </button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted" style="font-size:0.875rem;">No reviews yet. Be the first to share your experience!</p>
    <% } %>
  </div>

  <!-- Map -->
  <div class="map-section">
    <h3 class="section-heading">
      <i class="fa-solid fa-map-location-dot" style="color:var(--primary);"></i>
      Where you'll be
    </h3>
    <p class="text-muted mb-3" style="font-size:0.875rem;">
      <i class="fa-solid fa-location-dot me-1" style="color:var(--primary);"></i>
      <%= foundListing.location %>, <%= foundListing.country %>
    </p>
    <div id="map"></div>
  </div>

</div><!-- /show-page -->

<script src="/js/map.js"></script>
