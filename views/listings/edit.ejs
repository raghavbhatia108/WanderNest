<% layout('/layouts/boilerplate') %>

<div class="form-page">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9 col-12">
      <div class="form-card">

        <!-- Header -->
        <div class="mb-4">
          <a href="/listings/<%= foundListing._id %>"
            class="text-muted text-decoration-none d-inline-flex align-items-center gap-1 mb-3"
            style="font-size:0.85rem;">
            <i class="fa-solid fa-arrow-left"></i> Back to listing
          </a>
          <h2>Edit your listing</h2>
          <p class="form-subtitle">Update the details below to keep your listing fresh</p>
        </div>

        <form action="/listings/<%= foundListing._id %>?_method=PUT" method="post"
          novalidate class="needs-validation" enctype="multipart/form-data">

          <p class="form-section-label">Basic info</p>

          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">Listing title</label>
            <input type="text" name="listing[title]" id="title"
              value="<%= foundListing.title %>" class="form-control" required>
            <div class="valid-feedback">Looks great!</div>
            <div class="invalid-feedback">Please add a title.</div>
          </div>

          <!-- Description — BUG FIX: value pre-populated inside textarea tags -->
          <div class="mb-4">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description"
              class="form-control" rows="4" required><%= foundListing.description %></textarea>
            <div class="invalid-feedback">Please add a description.</div>
          </div>

          <p class="form-section-label">Location</p>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="location" class="form-label">City / Area</label>
              <input type="text" name="listing[location]" id="location"
                value="<%= foundListing.location %>" class="form-control" required>
              <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <div class="col-md-6">
              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" id="country"
                value="<%= foundListing.country %>" class="form-control" required>
              <div class="invalid-feedback">Please enter a country.</div>
            </div>
          </div>

          <p class="form-section-label">Pricing &amp; Photos</p>

          <!-- Price -->
          <div class="mb-3">
            <label for="price" class="form-label">Price per night (₹)</label>
            <div class="input-group">
              <span class="input-group-text"
                style="border:1.5px solid var(--border);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);background:var(--bg);">₹</span>
              <input type="number" name="listing[price]" id="price"
                value="<%= foundListing.price %>" class="form-control" min="0" required
                style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;">
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
          </div>

          <!-- Current image preview -->
          <div class="mb-3">
            <p class="form-label mb-2">Current photo</p>
            <div class="img-preview-wrap">
              <img src="<%= originalImageUrl %>" alt="Current listing photo">
            </div>
          </div>

          <!-- New image upload -->
          <div class="mb-4">
            <label for="image" class="form-label">Replace photo (optional)</label>
            <input type="file" name="listing[image]" id="image" class="form-control" accept="image/*">
            <div class="form-text text-muted" style="font-size:0.78rem;">
              <i class="fa-solid fa-circle-info me-1"></i>
              Leave empty to keep the current photo.
            </div>
          </div>

          <!-- Submit -->
          <div class="d-flex gap-2 align-items-center">
            <button type="submit" class="btn-accent-action">
              <i class="fa-solid fa-floppy-disk"></i> Save Changes
            </button>
            <a href="/listings/<%= foundListing._id %>"
              class="btn btn-outline-secondary rounded-pill px-3"
              style="font-size:0.875rem;">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
