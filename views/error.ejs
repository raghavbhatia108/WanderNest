<% layout("/layouts/boilerplate") %>

<div class="error-page">
  <div class="error-card">
    <div class="error-code"><%= statusCode || 500 %></div>
    <h3><%= message || "Something went wrong" %></h3>
    <p>We hit an unexpected error. Please try going back or returning to the homepage.</p>
    <div class="d-flex justify-content-center gap-2">
      <a href="javascript:history.back()"
        class="btn btn-outline-secondary rounded-pill px-4"
        style="font-size:0.875rem;">Go Back</a>
      <a href="/listings"
        class="btn-primary-action text-decoration-none"
        style="font-size:0.875rem;">Back to Home</a>
    </div>
  </div>
</div>
